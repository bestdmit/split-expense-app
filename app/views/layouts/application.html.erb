<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Split Expense</title>
  </head>

  <body>
    <header>
      <%= link_to "Split Expense", root_path %>
      <% if current_user %>
        <%= link_to "Профиль", profile_path %>
      <% end %>
    </header>

    <main>
      <% if notice %>
        <p><%= notice %></p>
      <% end %>
      <% if alert %>
        <p><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
