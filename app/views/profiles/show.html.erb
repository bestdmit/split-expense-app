<div class="card">
  <h1>Профиль</h1>
  <p class="muted">Эта страница открывается только после входа.</p>

  <ul class="list">
    <li><span>Email</span> <strong><%= current_user.email %></strong></li>
    <li><span>Зарегистрирован</span> <strong><%= current_user.created_at.strftime("%d.%m.%Y") %></strong></li>
  </ul>

  <div class="actions">
    <%= button_to "Выйти", logout_path, method: :delete, class: "btn" %>
  </div>
</div>
