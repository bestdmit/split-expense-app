<div class="card">
  <h1>Делим общие расходы</h1>
  <p class="muted">Учебное приложение: учёт общих трат и расчёт, кто кому сколько должен.</p>

  <% if current_user %>
    <p>Вы вошли как <strong><%= current_user.email %></strong></p>
    <div class="actions">
      <%= link_to "Профиль", profile_path, class: "btn btn-secondary" %>
      <%= link_to "Участники", participants_path, class: "btn" %>
      <%= link_to "Траты", expenses_path, class: "btn" %>
      <%= link_to "Итог", settlement_path, class: "btn" %>
      <%= button_to "Выйти", logout_path, method: :delete, class: "btn" %>
    </div>
  <% else %>
    <p>Вы не вошли.</p>
    <div class="actions">
      <%= link_to "Войти", login_path, class: "btn" %>
      <%= link_to "Регистрация", signup_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
