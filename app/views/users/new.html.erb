<h1>Регистрация</h1>

<%= form_with model: @user, url: signup_path do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email %>
  </p>

  <p>
    <%= f.label :password, "Пароль (минимум 6 символов)" %>
    <%= f.password_field :password %>
  </p>

  <%= f.submit "Зарегистрироваться" %>
<% end %>

<p>Уже есть аккаунт? <%= link_to "Войти", login_path %></p>
