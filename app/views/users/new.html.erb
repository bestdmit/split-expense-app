<div class="card card-narrow">
  <h1>Регистрация</h1>

  <%= form_with model: @user, url: signup_path do |f| %>
    <% if @user.errors.any? %>
      <ul class="errors">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>

    <div class="field">
      <%= f.label :password, "Пароль" %>
      <%= f.password_field :password %>
      <p class="hint">Минимум 6 символов</p>
    </div>

    <%= f.submit "Зарегистрироваться", class: "btn" %>
  <% end %>

  <p class="muted">Уже есть аккаунт? <%= link_to "Войти", login_path %></p>
</div>
