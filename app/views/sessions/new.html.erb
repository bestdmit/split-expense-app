<div class="card card-narrow">
  <h1>Вход</h1>

  <%= form_with url: login_path do |f| %>
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, value: params[:email] %>
    </div>

    <div class="field">
      <%= f.label :password, "Пароль" %>
      <%= f.password_field :password %>
    </div>

    <%= f.submit "Войти", class: "btn" %>
  <% end %>

  <p class="muted">Нет аккаунта? <%= link_to "Зарегистрироваться", signup_path %></p>
</div>
